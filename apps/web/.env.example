# Upstash Redis (GitHub data caching + chat rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI (chat)
OPENAI_API_KEY=

# GitHub token for public repository inventory and live lookups
GH_INVENTORY_TOKEN=

# OpenAI model for assistant responses
ASSISTANT_MODEL=

# Google API key enabling the assistant fallback
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model used when the primary model fails
ASSISTANT_FALLBACK_MODEL=

# Site-wide daily assistant request limit
ASSISTANT_DAILY_CAP=

# Secret for trusted assistant relays
ASSISTANT_RELAY_TOKEN=

# Local inventory snapshot path
INVENTORY_FILE=

# Secret for GET /api/chat-stats (send as "Authorization: Bearer <token>")
CHAT_STATS_TOKEN=

# Bearer token for owner-only guestbook entry deletion
ADMIN_TOKEN=

# Secret salt for anonymous guestbook daily limits
GUESTBOOK_SALT=

# Turnstile server secret (always-pass local test key: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=

# Public Turnstile site key (always-pass local test key: 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
